# =============================================================================
# .env.example - Environment variables for the Ambient Medical Scribe
# =============================================================================
#
# Copy this file to .env and customize it:
#   cp .env.example .env
#
# Read by: Symfony (APP_*, MERCURE_*), Docker Compose (all vars)
# =============================================================================

# ============================================================
# Symfony Application
# ============================================================
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=changeme
AGENT_ENDPOINT=http://localhost:48101

# ============================================================
# Observability
# ============================================================
# console keeps local logs readable; json enables scripts/analyze-logs.py.
LOG_FORMAT=console
LOG_LEVEL=INFO
# Optional Strands/OpenTelemetry exporter; leave unset for local JSON-log capture.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# STRANDS_OTEL=console

# WebSocket URL for the NeMo agent (browser connects directly)
#   Local dev:  ws://localhost:48101
#   Docker:     ws://localhost:48101 (port mapped from container)
#   Production: wss://scribe.blundergoat.com (TLS required for getUserMedia)
NEMO_WEBSOCKET_URL=ws://localhost:48101

# ============================================================
# NeMo Configuration
# ============================================================
# Model provider for the NeMo transcription pipeline
NEMO_MODEL_PROVIDER=local
NEMO_STREAM_INPUT_FORMAT=pcm

# NeMo executor thread pool size (concurrent GPU inference workers)
NEMO_MAX_WORKERS=2

# Maximum audio buffer duration in seconds (safety cap for memory)
NEMO_BUFFER_MAX_DURATION=900

# Session store limits
MAX_SESSIONS=100
SESSION_TTL_SECONDS=7200

# Session storage backend: "memory" (default, in-process) or "sqlite" (persistent)
SESSION_STORAGE=memory
# Path to the SQLite database file (only used when SESSION_STORAGE=sqlite)
# In Docker, this should point to a mounted volume for persistence across restarts.
SESSION_DB_PATH=/data/sessions.db

# ============================================================
# Role Inference Agent (Strands)
# ============================================================
# GPU is reserved for NeMo - role inference uses Ollama (default for local dev)
# or Bedrock (opt-in for cloud deployment).
# "ollama" for local CPU-only Ollama (default, fully offline)
# "bedrock" for AWS Bedrock (requires AWS credentials)
#ROLE_AGENT_MODEL_PROVIDER=ollama
ROLE_AGENT_MODEL_PROVIDER=bedrock
ROLE_AGENT_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AWS credentials (for Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2

# --- Ollama settings (for role agent when ROLE_AGENT_MODEL_PROVIDER=ollama) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_PORT=11434
#
# Note: Ollama runs on CPU (GPU is reserved for NeMo transcription)
#
# To use the Docker Compose Ollama service instead of a host-installed Ollama:
#   docker compose --profile local up
#   Set OLLAMA_HOST=http://ollama:11434 (for container-to-container access)
ROLE_AGENT_OLLAMA_MODEL=qwen3.5:9b

# ============================================================
# Clinical assistance
# ============================================================
# 1 shows clinician-review hints after summary generation; 0 hides the hints lane.
CLINICAL_HINTS_ENABLED=1
# 0 leaves ASR text raw; 1 enables conservative post-ASR clinical term correction.
MEDICAL_BOOST_ENABLED=0
MEDICAL_LEXICON_PATH=/app/data/medical_lexicon.txt

# ============================================================
# Mercure - Real-time transcript streaming
# ============================================================
MERCURE_JWT_SECRET=changemechangemechangemechangeme
MERCURE_URL=http://localhost:48137/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:48137/.well-known/mercure
# Optional dev override for Mercure CORS. Keep this scoped to trusted local
# origins; only use "*" for short-lived debugging.
# MERCURE_CORS_ORIGINS=http://localhost:48082
# MERCURE_PUBLISHER_JWT - JWT token for Python agent to publish to Mercure
# Generate with: php -r "echo base64_encode(json_encode(['mercure' => ['publish' => ['*']]]));"
MERCURE_PUBLISHER_JWT=

