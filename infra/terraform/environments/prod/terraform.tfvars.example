# =============================================================================
# PROD ENVIRONMENT CONFIGURATION - Copy this to terraform.tfvars
# =============================================================================
#
# By default, this configuration creates its own VPC.
# If you have an existing VPC, uncomment the BYO section below.
#
# Required: hosted_zone_id (or set create_hosted_zone = true)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------

aws_region   = "us-east-1"
environment  = "prod"
project_name = "ambient-scribe"

# -----------------------------------------------------------------------------
# VPC — Option A: Create new (default, no changes needed)
# -----------------------------------------------------------------------------

# A new VPC is created automatically. Customize CIDRs if needed:
# vpc_cidr             = "10.0.0.0/16"
# public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
# enable_nat_gateway   = true
# single_nat_gateway   = true

# -----------------------------------------------------------------------------
# VPC — Option B: Bring your own (uncomment to use existing VPC)
# -----------------------------------------------------------------------------

# vpc_id             = "vpc-0123456789abcdef0"
# public_subnet_ids  = ["subnet-aaa", "subnet-bbb"]
# private_subnet_ids = ["subnet-ccc", "subnet-ddd"]

# -----------------------------------------------------------------------------
# DNS Settings
# -----------------------------------------------------------------------------

domain_name      = "blundergoat.com"
subdomain        = "scribe"

# Set to true to create a new hosted zone, or provide an existing one below
create_hosted_zone = false

# Route53 hosted zone ID for blundergoat.com
hosted_zone_id = ""

# -----------------------------------------------------------------------------
# Agent Settings
# -----------------------------------------------------------------------------

# Bedrock model to use
model_id = "us.anthropic.claude-sonnet-4-20250514-v1:0"

# Docker image tag (use a unique tag when ECR is immutable)
agent_image_tag = "latest"

# ALB idle timeout (120s for streaming responses)
alb_idle_timeout_seconds = 120

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# API key for authenticating agent requests.
# Leave empty to auto-generate. Retrieve with:
#   aws secretsmanager get-secret-value --secret-id /ambient-scribe/prod/api-key
api_key = ""

# Secrets Manager deletion window (0 for immediate in dev)
secrets_recovery_window_days = 0

# WAF rate limit (requests per 5 minutes per IP)
waf_rate_limit = 2000

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

# Email for CloudWatch alarm notifications (confirm subscription via email)
alarm_email = ""

# Agent log retention (days)
agent_log_retention_days = 14

# -----------------------------------------------------------------------------
# CI/CD (GitHub Actions OIDC)
# -----------------------------------------------------------------------------

# GitHub repository for OIDC (format: "owner/repo")
# After terraform apply, copy github_actions_role_arn to GitHub secrets as AWS_ROLE_ARN
github_repository = ""
