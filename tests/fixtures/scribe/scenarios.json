            "name": "High Volume Stress",
            "description": "50 segments at 50ms spacing for performance testing",
            "events": [
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 1: Patient presents with acute lower back pain.", "start": 0.0, "end": 2.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 2: Pain started three days ago after lifting.", "start": 2.0, "end": 4.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 3: Any numbness or tingling in legs?", "start": 4.0, "end": 6.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 4: No numbness but the pain radiates down my right leg.", "start": 6.0, "end": 8.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 5: That could indicate sciatica.", "start": 8.0, "end": 10.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 6: Is that serious?", "start": 10.0, "end": 12.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 7: Usually resolves with conservative treatment.", "start": 12.0, "end": 14.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 8: What kind of treatment?", "start": 14.0, "end": 16.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 9: Physical therapy and anti-inflammatory medication.", "start": 16.0, "end": 18.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 10: How long until I feel better?", "start": 18.0, "end": 20.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 11: Most patients improve within 4-6 weeks.", "start": 20.0, "end": 22.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 12: Should I avoid any activities?", "start": 22.0, "end": 24.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 13: Avoid heavy lifting and prolonged sitting.", "start": 24.0, "end": 26.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 14: I work at a desk all day.", "start": 26.0, "end": 28.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 15: Take breaks every 30 minutes to stand and stretch.", "start": 28.0, "end": 30.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 16: I'll try that.", "start": 30.0, "end": 32.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 17: I'm also ordering an MRI to rule out disc herniation.", "start": 32.0, "end": 34.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 18: When will I get the results?", "start": 34.0, "end": 36.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 19: Usually within 3-5 business days.", "start": 36.0, "end": 38.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 20: Okay, thank you doctor.", "start": 38.0, "end": 40.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 21: Let me also check your reflexes.", "start": 40.0, "end": 42.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 22: Sure, go ahead.", "start": 42.0, "end": 44.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 23: Reflexes appear normal bilaterally.", "start": 44.0, "end": 46.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 24: That's reassuring.", "start": 46.0, "end": 48.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 25: Now let's test your range of motion.", "start": 48.0, "end": 50.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 26: It hurts when I bend forward.", "start": 50.0, "end": 52.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 27: Noted. How about bending to the sides?", "start": 52.0, "end": 54.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 28: Left side is okay, right side hurts.", "start": 54.0, "end": 56.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 29: Consistent with right-sided radiculopathy.", "start": 56.0, "end": 58.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 30: What does that mean exactly?", "start": 58.0, "end": 60.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 31: A nerve root is being compressed or irritated.", "start": 60.0, "end": 62.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 32: Will it go away on its own?", "start": 62.0, "end": 64.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 33: Often yes, but the MRI will help us decide.", "start": 64.0, "end": 66.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 34: And the physical therapy starts when?", "start": 66.0, "end": 68.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 35: I'll put in a referral today.", "start": 68.0, "end": 70.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 36: How many sessions will I need?", "start": 70.0, "end": 72.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 37: Usually 6-8 sessions over 4-6 weeks.", "start": 72.0, "end": 74.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 38: Does insurance cover that?", "start": 74.0, "end": 76.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 39: Most plans cover PT with a referral.", "start": 76.0, "end": 78.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 40: Good to know.", "start": 78.0, "end": 80.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 41: I'm prescribing naproxen 500mg twice daily.", "start": 80.0, "end": 82.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 42: Any side effects I should watch for?", "start": 82.0, "end": 84.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Segment 43: Take with food to avoid stomach irritation.", "start": 84.0, "end": 86.0}},
                {"type": "segment", "delay": 50, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Segment 44: Will do.", "start": 86.0, "end": 88.0}},
