            "name": "Happy Path \u2014 2-Speaker Consultation",
            "description": "Basic 2-speaker consultation with role assignment",
            "events": [
                {"type": "segment", "delay": 300, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Good morning, how are you feeling today?", "start": 0.0, "end": 3.2}},
                {"type": "segment", "delay": 500, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Hi doctor, I've been having headaches for the past week.", "start": 3.5, "end": 7.1}},
                {"type": "segment", "delay": 400, "data": {"type": "segment", "speaker_id": "spk_0", "text": "I see. Can you describe the pain? Is it throbbing or constant?", "start": 7.5, "end": 11.0}},
                {"type": "segment", "delay": 600, "data": {"type": "segment", "speaker_id": "spk_1", "text": "It's mostly throbbing, usually on the right side.", "start": 11.5, "end": 14.8}},
                {"type": "segment", "delay": 400, "data": {"type": "segment", "speaker_id": "spk_0", "text": "Any nausea or sensitivity to light?", "start": 15.2, "end": 17.5}},
                {"type": "segment", "delay": 500, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Yes, bright lights make it worse.", "start": 18.0, "end": 20.3}},
                {"type": "segment", "delay": 400, "data": {"type": "segment", "speaker_id": "spk_0", "text": "That sounds like it could be a migraine. Have you tried any over-the-counter medications?", "start": 21.0, "end": 25.5}},
                {"type": "segment", "delay": 500, "data": {"type": "segment", "speaker_id": "spk_1", "text": "I've been taking ibuprofen but it only helps a little.", "start": 26.0, "end": 29.2}},
                {"type": "segment", "delay": 400, "data": {"type": "segment", "speaker_id": "spk_0", "text": "I'd like to prescribe sumatriptan. Take it at onset of symptoms.", "start": 30.0, "end": 34.5}},
                {"type": "segment", "delay": 300, "data": {"type": "segment", "speaker_id": "spk_1", "text": "Thank you, doctor. I'll try that.", "start": 35.0, "end": 37.2}},
                {"type": "role_update", "delay": 200, "data": {"mapping": {"spk_0": "DOCTOR", "spk_1": "PATIENT"}, "confidence": 0.92}}
            ],
            "expectedEndState": {
                "segmentCount": 10,
