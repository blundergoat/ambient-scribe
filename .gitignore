# PHP
vendor/
var/
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpstan-cache/
coverage-html/
coverage.xml
.infection/
infection.log

# Python
__pycache__/
*.pyc
*.pyo
strands_agents/**/.venv/

# Environment
# .env is ignored because Docker Compose reads it and users customize it
# (e.g. Bedrock credentials). Use .env.example as the template.
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
tasks/todo.md
tasks/handoff.md
/commit.md
/release.md

# Node
node_modules/

# Playwright / test output
test-results/

# OS
.DS_Store

# Docker
docker-compose.override.yml

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
backend.hcl
crash.log

# NeMo models (too large for git)
*.nemo

# Audio fixtures (YouTube-extracted files must NOT be committed)
# Self-recorded audio is OK to commit explicitly
tests/fixtures/audio/*.wav
tests/fixtures/audio/*.mp3
tests/fixtures/audio/*.webm
!tests/fixtures/audio/.gitkeep
