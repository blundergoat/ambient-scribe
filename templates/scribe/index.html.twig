<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ambient Scribe - Real-time Transcription</title>
    <script>
        // Apply the saved theme before first paint so refresh does not flash light→dark.
        (function () {
            try {
                if (localStorage.getItem('ambient-scribe-theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (themeError) { /* localStorage may be blocked; fall back to light. */ }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Libre+Franklin:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/js/tailwind.js"></script>
    <style>
        :root {
            color-scheme: light;
            --page-bg: #f6f5f2;
            --surface-bg: #ffffff;
            --surface-bg-alt: #fafbfc;
            --surface-border: #ece9e3;
            --surface-hover: #f1f7fd;
            --surface-selected: #eef3f9;
            --text-strong: #1c2b33;
            --text-muted: #6b7a82;
            --text-subtle: #8a97a0;
            --accent: #2f6db0;
            --accent-soft: #dce9f7;
            --color-speaker-a: #2f6db0;
            --color-speaker-a-bg: #f1f6fb;
            --color-speaker-a-border: #dbe7f5;
            --color-speaker-b: #2e7a64;
            --color-speaker-b-bg: #f0f6f3;
            --color-speaker-b-border: #d7ebe2;
            --color-unknown: #6b7a82;
            --color-unknown-bg: #fafbfc;
            --color-unknown-border: #e6e8eb;
            --color-success: #4e9e78;
            --color-danger: #c0392b;
            --shadow-sm: 0 1px 2px rgba(20,40,60,0.06);
            --shadow-md: 0 14px 34px -14px rgba(20,40,60,0.35);
            --radius: 0.5rem;
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --page-bg: #0e141b;
            --surface-bg: #16202b;
            --surface-bg-alt: #111a24;
            --surface-border: #243342;
            --surface-hover: #132434;
            --surface-selected: #132434;
            --text-strong: #e6edf3;
            --text-muted: #8fa0ae;
            --text-subtle: #7c8b99;
            --accent: #4e96e0;
            --accent-soft: #173049;
            --color-speaker-a: #6bb0ff;
            --color-speaker-a-bg: #132434;
            --color-speaker-a-border: #1e3346;
            --color-speaker-b: #5fd0a8;
            --color-speaker-b-bg: #112a22;
            --color-speaker-b-border: #1d3a30;
            --color-unknown: #8fa0ae;
            --color-unknown-bg: #111a24;
            --color-unknown-border: #243342;
            --color-success: #5fd0a8;
            --color-danger: #f87171;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
            --shadow-md: 0 14px 34px -14px rgba(0,0,0,0.6);
        }

        * { box-sizing: border-box; }

        html { background: var(--page-bg); }
        body {
            background: var(--page-bg);
            color: var(--text-strong);
            transition: background-color 0.2s, color 0.2s;
            margin: 0;
            font-family: "Libre Franklin", -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }

        .app-layout {
            height: 100vh;
            overflow: hidden;
            background: var(--page-bg);
        }
        .app-layout:not(.app-layout--dev) {
            max-width: 64rem;
            margin: 0 auto;
        }

        /* Dev mode: workspace 10/12 (transcript 5 + summary 5), dev rail 2/12. */
        .app-layout--dev {
            display: grid;
            grid-template-columns: minmax(0, 10fr) minmax(200px, 2fr);
            height: 100vh;
            max-width: none;
            margin: 0;
        }

        /* Collapsed dev panel shrinks to a slim vertical strip on the right edge. */
        .app-layout--dev:has(.dev-panel--collapsed) {
            grid-template-columns: minmax(0, 1fr) 2.75rem;
        }

        .app-layout--dev > .dev-panel {
            grid-column: 2;
            min-height: 0;
            border-left: 1px solid var(--surface-border);
        }

        .app-layout--dev > .scribe-workspace {
            grid-column: 1;
        }

        .scribe-workspace {
            min-width: 0;
            height: 100vh;
            min-height: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1.875rem 1.375rem;
        }

        .scribe-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.125rem;
        }

        .scribe-title-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .controls-panel {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            flex-wrap: wrap;
            padding: 0.9375rem 1rem;
            margin-bottom: 0.875rem;
        }

        .status-cluster {
            display: flex;
            align-items: center;
            gap: 0.6875rem;
            flex-wrap: wrap;
            margin-left: auto;
            min-width: 0;
        }

        .consultation-workspace {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 0.875rem;
        }

        /* Once the summary opens, transcript and summary split 5:5. */
        .consultation-workspace:has(.summary-panel:not(.hidden)) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }

        .summary-column {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
            min-height: 0;
        }
        /* An all-hidden column must not occupy the grid track's gap. */
        .summary-column:not(:has(.summary-panel:not(.hidden))) {
            display: none;
        }

        .transcript-panel {
            min-height: 0;
            max-height: none;
            overflow-y: auto;
            padding: 0.5rem;
        }

        /* ---- Segment Styles ---- */
        .segment {
            --segment-accent: var(--text-muted);
            --segment-hover-bg: var(--surface-hover);
            display: flex;
            gap: 0.75rem;
            padding: 0.875rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: var(--radius);
            border: 1px solid transparent;
            transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        }
        .segment:hover {
            background: var(--segment-hover-bg);
            border-color: var(--segment-accent);
            box-shadow: inset 3px 0 0 var(--segment-accent), var(--shadow-sm);
            transform: translateY(-1px);
        }

        .segment--DOCTOR {
            --segment-accent: var(--color-speaker-a);
            --segment-hover-bg: color-mix(in srgb, var(--color-speaker-a-bg) 88%, var(--color-speaker-a) 12%);
            border-color: var(--color-speaker-a-border);
            background: var(--color-speaker-a-bg);
        }
        .segment--PATIENT {
            --segment-accent: var(--color-speaker-b);
            --segment-hover-bg: color-mix(in srgb, var(--color-speaker-b-bg) 88%, var(--color-speaker-b) 12%);
            border-color: var(--color-speaker-b-border);
            background: var(--color-speaker-b-bg);
        }
        .segment--UNKNOWN {
            --segment-accent: var(--color-unknown);
            --segment-hover-bg: color-mix(in srgb, var(--color-unknown-bg) 88%, var(--color-unknown) 12%);
            border-color: var(--color-unknown-border);
            background: var(--color-unknown-bg);
        }

        .segment--relabeled {
            animation: segment-relabel 0.6s ease-out;
        }
        @keyframes segment-relabel {
            0% { opacity: 0.6; transform: translateX(-2px); }
            50% { opacity: 1; }
            100% { opacity: 1; transform: translateX(0); }
        }

        .segment__avatar {
            width: 2.125rem;
            height: 2.125rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.6875rem;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }
        .segment--DOCTOR .segment__avatar {
            background: var(--color-speaker-a-border);
            color: var(--color-speaker-a);
        }
        .segment--PATIENT .segment__avatar {
            background: var(--color-speaker-b-border);
            color: var(--color-speaker-b);
        }
        .segment--UNKNOWN .segment__avatar {
            background: var(--color-unknown-border);
            color: var(--color-unknown);
        }

        .segment__body { flex: 1; min-width: 0; }

        .segment__header {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            margin-bottom: 0.125rem;
        }

        .segment__speaker {
            display: inline-block;
            font-weight: 600;
            font-size: 0.8125rem;
            line-height: 1.4;
            border-radius: 999px;
            padding: 0.0625rem 0.375rem;
            margin: -0.0625rem -0.375rem;
            transition: background-color 0.15s, transform 0.15s;
        }
        .segment--DOCTOR .segment__speaker { color: var(--color-speaker-a); }
        .segment--PATIENT .segment__speaker { color: var(--color-speaker-b); }
        .segment--UNKNOWN .segment__speaker { color: var(--color-unknown); }

        .segment__speaker[style*="cursor: pointer"]:hover {
            background: color-mix(in srgb, currentColor 12%, transparent);
            text-decoration: none;
            transform: scale(1.02);
        }

        .segment__override-icon {
            display: inline-block;
            font-size: 0.625rem;
            margin-left: 0.25rem;
            vertical-align: super;
            opacity: 0.7;
        }

        .segment__time {
            font-size: 0.6875rem;
            color: var(--text-subtle);
            font-variant-numeric: tabular-nums;
        }

        .segment__texts {
            display: block;
            color: var(--text-strong);
            line-height: 1.6;
            font-size: 0.9375rem;
        }
        .segment__text {
            display: inline;
        }
        .segment__text + .segment__text::before {
            content: ' ';
        }
        /* Rows with a stable ID are individually correctable by clicking. */
        .segment__text[data-segment-id] {
            cursor: pointer;
        }
        .segment__text[data-segment-id]:hover {
            background: color-mix(in srgb, currentColor 8%, transparent);
            border-radius: 3px;
        }
        /* A row the clinician corrected keeps a subtle marker even after
           later automatic role updates restyle the surrounding card. */
        .segment__text--corrected {
            text-decoration: underline dotted;
            text-underline-offset: 3px;
        }
        .segment__row-role {
            display: inline-block;
            font-size: 0.625rem;
            font-weight: 600;
            margin-left: 0.25rem;
            padding: 0 0.3rem;
            border-radius: 9999px;
            background: color-mix(in srgb, currentColor 12%, transparent);
            vertical-align: super;
            user-select: none;
        }
        /* Automatic row exceptions look tentative (outline, no fill) so the
           clinician can tell a machine judgment from their own "✓" correction. */
        .segment__row-role--auto {
            background: transparent;
            border: 1px dashed color-mix(in srgb, currentColor 45%, transparent);
            opacity: 0.85;
        }

        @media (prefers-reduced-motion: reduce) {
            .segment {
                transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s;
            }
            .segment:hover,
            .segment__speaker[style*="cursor: pointer"]:hover {
                transform: none;
            }
        }

        /* ---- Summary Panel ---- */
        .summary-panel {
            border: 1px solid var(--surface-border);
            border-radius: var(--radius);
            background: var(--surface-bg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 0;
            max-height: none;
        }
        .summary-panel.hidden { display: none; }
        .summary-panel__header {
            display: flex;
            align-items: center;
            padding: 0.875rem 1rem;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-strong);
        }
        .summary-panel__body {
            padding: 0 1rem 1rem;
            display: block;
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }
        .summary-panel__loading {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem;
            color: var(--text-subtle);
            font-size: 0.875rem;
        }
        .summary-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 0.875rem;
        }
        .summary-status.hidden { display: none; }
        .summary-status__badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.1875rem 0.625rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.5;
        }
        .summary-status__badge--generated {
            color: var(--color-success);
            background: color-mix(in srgb, var(--color-success) 15%, transparent);
        }
        .summary-status__badge--failed {
            color: var(--color-danger);
            background: color-mix(in srgb, var(--color-danger) 15%, transparent);
        }
        .summary-status__retry {
            font: inherit;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent);
            background: none;
            border: 1px solid var(--surface-border);
            border-radius: 999px;
            padding: 0.1875rem 0.625rem;
            cursor: pointer;
        }
        .summary-status__retry:hover { background: var(--surface-hover); }
        .summary-status__retry.hidden { display: none; }
        .summary-pending {
            display: flex;
            align-items: flex-start;
            gap: 0.6875rem;
            padding: 0.8125rem 0.875rem;
            background: var(--surface-bg-alt);
            border: 1px solid var(--surface-border);
            border-radius: 0.6875rem;
        }
        .summary-pending.hidden { display: none; }
        .summary-pending__bars {
            display: flex;
            gap: 3px;
            align-items: flex-end;
            height: 16px;
            margin-top: 2px;
            flex-shrink: 0;
        }
        .summary-pending__bar {
            width: 3px;
            height: 5px;
            background: var(--color-speaker-b);
            border-radius: 2px;
            animation: summary-eqbar 0.9s ease-in-out infinite;
        }
        .summary-pending__bar:nth-child(2) { animation-delay: 0.15s; }
        .summary-pending__bar:nth-child(3) { animation-delay: 0.3s; }
        .summary-pending__text {
            font-size: 0.8125rem;
            line-height: 1.5;
            color: var(--text-muted);
        }
        @keyframes summary-eqbar {
            0%, 100% { height: 5px; }
            50% { height: 15px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .summary-pending__bar { animation: none; height: 12px; }
        }
        .summary-section { margin-bottom: 1rem; }
        .summary-section:last-child { margin-bottom: 0; }
        .summary-section__heading {
            font-weight: 600;
            font-size: 0.8125rem;
            color: var(--text-subtle);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.375rem;
        }
        .summary-section__content {
            font-size: 0.9375rem;
            line-height: 1.6;
            color: var(--text-strong);
        }
        .summary-section { position: relative; }
        .summary-provenance {
            display: inline-block;
            margin-left: 0.25rem;
        }
        .summary-provenance__toggle {
            font-size: 0.6875rem;
            font-weight: 700;
            line-height: 1;
            vertical-align: super;
            padding: 0.0625rem 0.375rem;
            border: 1px solid var(--surface-border);
            border-radius: 999px;
            background: var(--surface-bg-alt);
            color: var(--accent);
            cursor: pointer;
        }
        .summary-provenance__toggle:hover,
        .summary-provenance__toggle[aria-expanded="true"] {
            background: var(--surface-hover);
            border-color: color-mix(in srgb, var(--accent) 35%, var(--surface-border));
        }
        .summary-provenance__popover {
            position: absolute;
            z-index: 30;
            left: 0;
            right: 0;
            top: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
            padding: 0.5rem;
            border: 1px solid var(--surface-border);
            border-radius: 0.5rem;
            background: var(--surface-bg);
            box-shadow: var(--shadow-md);
        }
        .summary-provenance__open {
            align-self: flex-end;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.25rem 0.625rem;
            border: 1px solid var(--surface-border);
            border-radius: 999px;
            background: var(--surface-bg-alt);
            color: var(--accent);
            cursor: pointer;
        }
        .summary-provenance__open:hover {
            background: var(--surface-hover);
        }
        .summary-key-points {
            list-style: disc;
            padding-left: 1.25rem;
            font-size: 0.875rem;
            line-height: 1.6;
            color: var(--text-strong);
        }
        .summary-tabs {
            display: flex;
            gap: 0.25rem;
            margin-left: auto;
        }
        .summary-tab {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.25rem 0.625rem;
            border: 1px solid transparent;
            border-radius: 999px;
            background: transparent;
            color: var(--text-subtle);
            cursor: pointer;
        }
        .summary-tab:hover {
            color: var(--text-strong);
            background: var(--surface-hover);
        }
        .summary-tab[aria-selected="true"] {
            background: var(--surface-bg-alt);
            border-color: var(--surface-border);
            color: var(--text-strong);
        }
        .summary-transcript {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
        }
        .summary-transcript__block {
            display: grid;
            grid-template-columns: auto auto minmax(0, 1fr);
            align-items: baseline;
            gap: 0.5rem;
            padding: 0.4375rem 0.5625rem;
            border: 1px solid var(--surface-border);
            border-radius: 0.375rem;
            background: var(--surface-bg-alt);
            transition: background 0.6s ease, box-shadow 0.6s ease;
        }
        .summary-transcript__block--cited {
            background: color-mix(in srgb, var(--accent) 16%, transparent);
            box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 14%, transparent);
        }
        .summary-transcript__time,
        .summary-transcript__role {
            font-size: 0.6875rem;
            font-weight: 700;
            color: var(--text-subtle);
            white-space: nowrap;
        }
        .summary-transcript__text {
            min-width: 0;
            font-size: 0.8125rem;
            line-height: 1.5;
            color: var(--text-strong);
        }
        .summary-transcript__status {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin: 0 0 0.5rem;
        }

        .summary-column > .summary-panel {
            flex: 1;
            min-height: 0;
        }

        /* ---- Replay Progress ---- */
        .replay-progress {
            height: 0.375rem;
            background: var(--surface-border);
            border-radius: 999px;
            overflow: hidden;
            margin: 0 0 0.5rem;
        }
        .replay-progress__fill {
            height: 100%;
            background: var(--color-speaker-a);
            transition: width 0.5s linear;
            border-radius: 999px;
        }
        .replay-audio {
            width: 100%;
            display: block;
            margin: 0 0 0.875rem;
            border: 1px solid var(--surface-border);
            border-radius: var(--radius);
            background: var(--surface-bg);
            padding: 0.25rem 0.5rem;
            accent-color: var(--accent);
        }

        /* ---- Recording Pulse ---- */
        .recording-pulse { animation: pulse 1.5s ease-in-out infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

        .recording-dot {
            width: 8px; height: 8px;
            background: #ef4444;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }

        /* ---- Panels ---- */
        .panel {
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            transition: background-color 0.2s, border-color 0.2s;
        }

        .confidence-badge { transition: all 0.5s ease; }
        .muted-text { color: var(--text-muted); }
        .subtle-text { color: var(--text-subtle); }
        .title-text { color: var(--text-strong); }

        /* ---- Buttons ---- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6875rem 1rem;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.8125rem;
            transition: all 0.15s;
            cursor: pointer;
            border: none;
        }
        .btn--primary {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 4px 12px -3px rgba(47,109,176,0.5);
        }
        .btn--primary:hover { opacity: 0.9; }
        .btn--danger { background: #ef4444; color: #fff; }
        .btn--danger:hover { background: #dc2626; }
        .btn--ghost {
            background: transparent;
            border: 1px solid var(--surface-border);
            color: var(--text-muted);
        }
        .btn--ghost:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }

        /* ---- Icon Button ---- */
        .icon-btn {
            width: 2.25rem;
            height: 2.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.5rem;
            border: 1px solid var(--surface-border);
            background: var(--surface-bg);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .icon-btn:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .icon-btn:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }
        .icon-btn svg { width: 18px; height: 18px; }

        /* ---- Demo Audio Panel (left) ---- */
        /* Demo Audio selector lives in the header; sizing wrapper for the dropdown. */
        .audio-select-mount {
            position: relative;
            width: 300px;
            max-width: 40vw;
        }
        /* The header trigger matches the icon-btn height; the menu keeps its full rows. */
        .audio-select-mount .audio-select__trigger {
            height: 2.25rem;
            padding: 0 0.625rem;
            border-radius: 0.5rem;
        }
        .audio-select-mount .audio-select__sub { display: none; }
        .audio-select-mount .audio-select__indicators {
            flex-direction: row;
            gap: 0.375rem;
        }
        .audio-fixture-item--complete { border-left: 3px solid var(--color-success); }
        .audio-fixture-item--error { border-left: 3px solid var(--color-danger); }
        .audio-fixture-item--running {
            border-left: 3px solid var(--accent);
            background: var(--surface-hover);
        }
        /* ---- Demo Audio dropdown selector ---- */
        .audio-select { position: relative; }
        .audio-select__trigger {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.625rem 0.75rem;
            border: 1px solid var(--surface-border);
            border-radius: 0.625rem;
            background: var(--surface-bg-alt);
            color: inherit;
            font: inherit;
            text-align: left;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }
        .audio-select__trigger:hover { background: var(--surface-hover); border-color: var(--accent-soft); }
        .audio-select__main { flex: 1; min-width: 0; }
        .audio-select__title {
            display: block;
            font-weight: 600;
            font-size: 0.8125rem;
            color: var(--text-strong);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .audio-select__sub {
            display: block;
            font-size: 0.6875rem;
            color: var(--text-muted);
            margin-top: 0.1875rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .audio-select__indicators { flex: none; display: flex; align-items: center; }
        .audio-select__caret {
            display: flex;
            align-items: center;
            color: var(--text-subtle);
            transition: transform 0.15s;
        }
        .audio-select--open .audio-select__caret { transform: rotate(180deg); }
        .audio-select__menu {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 0.375rem);
            z-index: 30;
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            border-radius: 0.625rem;
            box-shadow: var(--shadow-md);
            padding: 0.25rem;
            max-height: 16rem;
            overflow-y: auto;
        }
        .audio-select__menu.hidden { display: none; }
        .audio-select__option {
            display: block;
            width: 100%;
            text-align: left;
            padding: 0.5rem 0.625rem;
            border: none;
            border-radius: 0.4375rem;
            background: none;
            color: inherit;
            font: inherit;
            cursor: pointer;
        }
        .audio-select__option:hover { background: var(--surface-hover); }
        .audio-select__option[aria-selected="true"] { background: var(--surface-selected); }
        .audio-select__option-title { display: block; font-weight: 600; font-size: 0.8125rem; color: var(--text-strong); }
        .audio-select__option-sub { display: block; font-size: 0.6875rem; color: var(--text-muted); margin-top: 0.125rem; }
        .audio-fixture-item__meta {
            font-size: 0.6875rem;
            color: var(--text-subtle);
            margin-top: 0.1875rem;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }
        .audio-fixture-item__status {
            font-size: 0.6875rem;
            margin-top: 0.25rem;
            color: var(--accent);
            font-weight: 600;
        }
        .audio-select__option--upload {
            border-top: 1px solid var(--surface-border);
            border-radius: 0;
            margin-top: 0.25rem;
            padding-top: 0.625rem;
        }

        /* ---- Dev Panel (right rail) ---- */
        .dev-panel {
            min-height: 0;
            overflow: hidden;
            border-top: 1px solid var(--surface-border);
            background: var(--surface-bg);
            display: flex;
            flex-direction: column;
            font-size: 0.8125rem;
            flex: 1;
        }
        .dev-panel__header {
            padding: 1rem 1.125rem 0;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .dev-panel__title {
            font-weight: 700;
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.13em;
            color: var(--text-subtle);
        }
        .dev-panel__status {
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: var(--text-subtle);
        }
        .dev-panel__status--on { color: var(--color-success); }
        .dev-panel__header-side {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .dev-panel__collapse {
            border: 0;
            background: none;
            color: var(--text-subtle);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 1.5rem;
            height: 1.5rem;
            padding: 0;
            border-radius: 0.375rem;
            transition: background 0.15s, color 0.15s;
        }
        .dev-panel__collapse:hover,
        .dev-panel__collapse:focus-visible {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .dev-panel__collapse .audio-select__caret { color: currentColor; }
        .dev-panel__collapse svg { display: block; }
        .dev-panel__collapse-caret { transform: rotate(-90deg); }
        .dev-panel--collapsed .dev-panel__collapse-caret { transform: rotate(90deg); }
        /* Collapsed: a slim vertical strip with the title reading downward. */
        .dev-panel--collapsed .dev-panel__tabs,
        .dev-panel--collapsed .dev-panel__content,
        .dev-panel--collapsed .dev-panel__status { display: none !important; }
        .dev-panel--collapsed .dev-panel__header {
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0 0;
        }
        .dev-panel--collapsed .dev-panel__title {
            writing-mode: vertical-rl;
            letter-spacing: 0.08em;
        }
        .dev-panel--collapsed .dev-panel__header-side {
            flex-direction: column;
            order: -1;
        }
        .dev-panel__tabs {
            display: flex;
            flex-wrap: wrap;
            overflow-x: visible;
            flex-shrink: 0;
            gap: 0.1875rem;
            padding: 0.75rem 1rem 0;
        }
        .dev-panel__tab {
            padding: 0.3125rem 0.5rem;
            background: none;
            border: none;
            color: var(--text-subtle);
            cursor: pointer;
            font-size: 0.625rem;
            font-weight: 600;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0;
            border-radius: 0.4375rem;
            transition: color 0.15s, background 0.15s;
        }
        .dev-panel__tab:hover { color: var(--text-strong); }
        .dev-panel__tab--active {
            color: var(--accent);
            background: var(--surface-selected);
        }
        .dev-panel__content {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem;
        }
        .dev-panel__log {
            font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.6875rem;
            line-height: 1.5;
            max-height: none;
            overflow-y: auto;
        }
        .dev-panel__entry {
            padding: 0.375rem 0.5rem;
            border-radius: 0.25rem;
            margin-bottom: 0.125rem;
            word-break: break-all;
            transition: background 0.1s;
        }
        .dev-panel__entry:hover { background: var(--surface-hover); }
        .dev-panel__pre {
            font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.6875rem;
            background: var(--surface-bg-alt);
            padding: 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--surface-border);
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            color: var(--text-strong);
        }
        .dev-panel__btn {
            padding: 0.25rem 0.625rem;
            font-size: 0.6875rem;
            font-weight: 500;
            border: 1px solid var(--surface-border);
            border-radius: 0.375rem;
            background: var(--surface-bg);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .dev-panel__btn:hover:not(:disabled) {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .dev-panel__btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .dev-panel__btn--primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .dev-panel__btn--primary:hover:not(:disabled) { opacity: 0.85; color: #fff; background: var(--accent); }
        .dev-panel__btn--danger { color: var(--color-danger); border-color: var(--color-danger); }

        .sr-only {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
        }

        @media (max-width: 1279px) {
            .app-layout--dev {
                display: block;
                max-width: none;
            }

            .dev-panel {
                position: fixed;
                top: 0;
                right: 0;
                height: 100vh;
                display: none;
                z-index: 50;
                box-shadow: var(--shadow-md);
                width: 85vw;
                max-width: 380px;
                border-top: 0;
            }
            .panel-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.3);
                z-index: 49;
            }
        }

        @media (max-width: 1023px) {
            .scribe-workspace {
                padding: 1rem;
            }

            .scribe-header,
            .status-cluster {
                align-items: flex-start;
            }

            .controls-panel {
                align-items: stretch;
            }

            .status-cluster {
                width: 100%;
                margin-left: 0;
            }

            .consultation-workspace,
            .consultation-workspace:has(.summary-panel:not(.hidden)) {
                grid-template-columns: minmax(0, 1fr);
            }

            .transcript-panel,
            .summary-panel {
                max-height: none;
            }
        }
    </style>
</head>
<body class="min-h-screen">
    {% set dev = dev_panel_enabled is defined and dev_panel_enabled %}

    <div id="appLayout" class="app-layout{% if dev %} app-layout--dev{% endif %}">

    {# ===== MAIN CONTENT ===== #}
    <main class="scribe-workspace">

        {# Header #}
        <div class="scribe-header">
            <div class="scribe-title-row">
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="title-text text-xl font-bold tracking-tight" id="appTitle">Ambient Scribe</h1>
                    </div>
                    <p class="mt-0.5 text-xs muted-text" id="appSubtitle">Consultation transcription with doctor and patient identification</p>
                    {% if dev %}
                    <p class="mt-0.5 text-xs muted-text">Start consultation below or select demo audio to the right</p>
                    {% endif %}
                </div>
            </div>
            <div class="flex items-center gap-2">
                {% if dev %}
                <div id="audioSelectMount" class="audio-select-mount"></div>
                <button onclick="toggleDevPanelMobile()" class="icon-btn xl:hidden" aria-label="Toggle dev panel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </button>
                {% endif %}
                <button id="themeToggle" type="button" onclick="toggleTheme()" class="icon-btn" aria-pressed="false" aria-label="Toggle theme">
                    <svg id="themeIconLight" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    <svg id="themeIconDark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                </button>
            </div>
        </div>

        {# Controls #}
        <div class="panel controls-panel">
            <button id="startBtn" onclick="startRecording()" class="btn btn--primary" aria-label="Start recording (Space)" title="Start recording (Space)">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="5"/></svg>
                <span id="startBtnLabel">Start Consultation</span>
                <span class="text-xs opacity-70">(Space)</span>
            </button>
            <button id="stopBtn" onclick="stopCurrentSession()" class="btn btn--danger hidden" aria-label="Stop current session (Space or Escape)" title="Stop current session (Space / Esc)">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect x="2" y="2" width="10" height="10" rx="1.5"/></svg>
                Stop
                <span class="text-xs opacity-70">(Space)</span>
            </button>
            <button id="reconnectBtn" onclick="reconnect()" class="btn btn--ghost hidden" style="border-color:#f59e0b; color:#f59e0b;" aria-label="Reconnect">Reconnect</button>
            <button id="resetBtn" onclick="resetSession()" class="btn btn--ghost hidden" aria-label="New session">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 105.64-11.36L1 10"/></svg>
                New Session
            </button>
            <input id="demoFileInput" type="file" accept=".wav,audio/wav" style="display:none" onchange="startReplay(this.files[0])">

            <div class="status-cluster">
                <span id="status" class="text-sm muted-text" aria-live="polite">Ready</span>
                <span id="audioLevel" class="hidden ml-2 text-xs" aria-live="polite"></span>
                <span id="confidenceBadge" class="confidence-badge text-xs px-2 py-0.5 rounded-full hidden" aria-label="Speaker identification confidence"></span>
                <span id="timer" class="text-sm font-mono subtle-text hidden" aria-label="Recording timer">00:00</span>
            </div>
        </div>

        {# System Banner #}
        <div id="systemBanner" class="hidden mb-4 px-4 py-3 rounded-lg bg-amber-100 text-amber-800 text-sm font-medium border border-amber-300"></div>

        {# Replay Progress #}
        <div id="replayProgress" class="replay-progress hidden">
            <div id="replayProgressFill" class="replay-progress__fill" style="width:0%"></div>
        </div>
        <audio id="replayAudio" class="replay-audio hidden" controls preload="metadata"></audio>

        {# Transcript and Summary #}
        <div class="consultation-workspace">
            <div id="transcript" role="log" aria-live="polite" class="panel transcript-panel">
                <p id="emptyState" class="text-center py-16">
                    <svg class="mx-auto mb-3" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-subtle)" stroke-width="1.5" stroke-linecap="round"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                    <span class="subtle-text block text-sm" id="emptyStateText">Click "Start Consultation" to begin transcription.</span>
                    <span class="subtle-text block text-xs mt-1">Ensure microphone access is allowed.</span>
                </p>
            </div>

            {# Summary occupies the right half of the workspace once generated #}
            <div class="summary-column">
                <div id="summaryPanel" class="summary-panel hidden">
                    <div class="summary-panel__header">
                        <span id="summaryTitle">Session Summary</span>
                        <div id="summaryTabs" class="summary-tabs" role="tablist" aria-label="Summary views">
                            <button id="summaryTabNote" type="button" class="summary-tab" role="tab"
                                    aria-selected="true" aria-controls="summaryNoteView"
                                    onclick="selectSummaryTab('note')">Note</button>
                            <button id="summaryTabTranscript" type="button" class="summary-tab" role="tab"
                                    aria-selected="false" aria-controls="summaryTranscriptView" tabindex="-1"
                                    onclick="selectSummaryTab('transcript')">Transcript</button>
                        </div>
                    </div>
                    <div id="summaryBody" class="summary-panel__body">
                        <div id="summaryNoteView" role="tabpanel" aria-labelledby="summaryTabNote">
                            <div id="summaryPending" class="summary-pending">
                                <span class="summary-pending__bars" aria-hidden="true">
                                    <span class="summary-pending__bar"></span>
                                    <span class="summary-pending__bar"></span>
                                    <span class="summary-pending__bar"></span>
                                </span>
                                <span class="summary-pending__text" id="summaryPendingText">Recording in progress, the summary will generate once consultation ends.</span>
                            </div>
                            <div id="summaryLoading" class="summary-panel__loading hidden">
                                <span class="recording-dot recording-pulse"></span>
                                <span id="summaryLoadingText">Generating summary...</span>
                            </div>
                            <div id="summaryStatus" class="summary-status hidden" role="status" aria-live="polite">
                                <span id="summaryStatusBadge" class="summary-status__badge"></span>
                                <button id="summaryRetryBtn" type="button" class="summary-status__retry hidden" onclick="requestSummary()">Retry Summary</button>
                            </div>
                            <div id="summaryContent"></div>
                        </div>
                        <div id="summaryTranscriptView" role="tabpanel" aria-labelledby="summaryTabTranscript" class="hidden">
                            <p id="summaryTranscriptStatus" class="summary-transcript__status hidden"></p>
                            <p id="summaryTranscriptNotice" class="summary-transcript__status hidden" role="status" aria-live="polite"></p>
                            <div id="summaryTranscript" class="summary-transcript"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Segment Count #}
        <div class="mt-1.5 text-xs muted-text text-right" role="status">
            <span id="segmentCount">0</span> segments
        </div>

        <div id="srAnnounce" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
    </main>

    {# ===== DEV PANEL (RIGHT RAIL) ===== #}
    {% if dev %}
    <aside id="devPanel" class="dev-panel">
        <div class="dev-panel__header">
            <span class="dev-panel__title">Dev Panel</span>
            <span class="dev-panel__header-side">
                <span id="devConnectionStatus" class="dev-panel__status">○ disconnected</span>
                <button id="devPanelCollapseBtn" class="dev-panel__collapse" type="button" onclick="toggleDevPanelCollapsed()" aria-expanded="true" aria-label="Collapse dev panel">
                    <span class="audio-select__caret dev-panel__collapse-caret" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </span>
                </button>
            </span>
        </div>
        <div class="dev-panel__tabs">
            <button class="dev-panel__tab dev-panel__tab--active" data-tab="segments" onclick="devPanel.switchTab('segments')">Segments</button>
            <button class="dev-panel__tab" data-tab="pipeline" onclick="devPanel.switchTab('pipeline')">Pipeline</button>
            <button class="dev-panel__tab" data-tab="mercure" onclick="devPanel.switchTab('mercure')">Mercure</button>
            <button class="dev-panel__tab" data-tab="websocket" onclick="devPanel.switchTab('websocket')">WS</button>
            <button class="dev-panel__tab" data-tab="state" onclick="devPanel.switchTab('state')">State</button>
            <button class="dev-panel__tab" data-tab="raw" onclick="devPanel.switchTab('raw')">Raw</button>
        </div>

        <div class="dev-panel__content" data-content="segments">
            <div class="flex justify-end mb-1">
                <button onclick="devPanel.clearSegmentLog()" class="dev-panel__btn">Clear</button>
            </div>
            <div id="devSegmentLog" class="dev-panel__log"></div>
        </div>

        <div class="dev-panel__content" data-content="pipeline" style="display:none;">
            <button onclick="devPanel.fetchHealth()" class="dev-panel__btn mb-2">Refresh Health</button>
            <pre id="devPipelineInfo" class="dev-panel__pre">Click Refresh to fetch /health</pre>
        </div>

        <div class="dev-panel__content" data-content="mercure" style="display:none;">
            <div id="devMercureLog" class="dev-panel__log">
                <div class="dev-panel__entry subtle-text">Waiting for Mercure events...</div>
            </div>
        </div>

        <div class="dev-panel__content" data-content="websocket" style="display:none;">
            <div id="devWsStatus" class="dev-panel__pre mb-2">No WebSocket connection</div>
            <div id="devWsLog" class="dev-panel__log"></div>
        </div>

        <div class="dev-panel__content" data-content="state" style="display:none;">
            <pre id="devStateSnapshot" class="dev-panel__pre">Loading...</pre>
        </div>

        <div class="dev-panel__content" data-content="raw" style="display:none;">
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs subtle-text"><span id="devRawCount">0</span>/200</span>
                <button onclick="devPanel.copyAllRaw()" class="dev-panel__btn">Copy All</button>
            </div>
            <div id="devRawLog" class="dev-panel__log"></div>
        </div>
    </aside>
    {% endif %}

    </div>{# /appLayout #}

    <script>
    const CONFIG = {
        sessionId: '{{ session_id }}',
        wsUrl: '{{ ws_url }}',
        mercureUrl: '{{ mercure_url }}',
        topicRaw: '{{ mercure_topic_raw }}',
        topicRoles: '{{ mercure_topic_roles }}',
        topicSummary: '{{ mercure_topic_summary }}',
        enableRoleUpdates: {{ enable_role_updates ? 'true' : 'false' }},
    };
    {% if dev_panel_enabled is defined and dev_panel_enabled %}
    const AUDIO_FIXTURES = {{ audio_fixtures|json_encode|raw }};
    {% endif %}
    </script>
    <script src="/js/scribe.js"></script>
    <script src="/js/scribe-streaming.js"></script>
    <script src="/js/scribe-recording.js"></script>
    <script src="/js/scribe-transcript.js"></script>
    <script src="/js/scribe-stitch.js"></script>
    <script src="/js/scribe-output.js"></script>
    <script src="/js/scribe-summary-tabs.js"></script>
    <script src="/js/scribe-provenance.js"></script>
    <script src="/js/scribe-actions.js"></script>
    {% if dev_panel_enabled is defined and dev_panel_enabled %}
    <script src="/js/scribe-dev.js"></script>
    <script src="/js/scribe-fixtures.js"></script>
    {% endif %}
</body>
</html>
