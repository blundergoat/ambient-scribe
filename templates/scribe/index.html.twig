<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ambient Scribe — Real-time Transcription</title>
    <script src="/js/tailwind.js"></script>
    <style>
        :root {
            color-scheme: light;
            --page-bg: #f1f5f9;
            --surface-bg: #ffffff;
            --surface-bg-alt: #f8fafc;
            --surface-border: #e2e8f0;
            --surface-hover: #f1f5f9;
            --text-strong: #0f172a;
            --text-muted: #475569;
            --text-subtle: #94a3b8;
            --accent: #3b82f6;
            --accent-soft: #dbeafe;
            --color-speaker-a: #2563eb;
            --color-speaker-a-bg: #eff6ff;
            --color-speaker-a-border: #bfdbfe;
            --color-speaker-b: #059669;
            --color-speaker-b-bg: #ecfdf5;
            --color-speaker-b-border: #a7f3d0;
            --color-unknown: #64748b;
            --color-unknown-bg: #f8fafc;
            --color-unknown-border: #e2e8f0;
            --color-success: #16a34a;
            --color-danger: #dc2626;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -2px rgba(0,0,0,0.05);
            --radius: 0.625rem;
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --page-bg: #020617;
            --surface-bg: #0f172a;
            --surface-bg-alt: #1e293b;
            --surface-border: #1e293b;
            --surface-hover: #1e293b;
            --text-strong: #f1f5f9;
            --text-muted: #94a3b8;
            --text-subtle: #64748b;
            --accent: #60a5fa;
            --accent-soft: #1e3a5f;
            --color-speaker-a: #93c5fd;
            --color-speaker-a-bg: #0c1d3a;
            --color-speaker-a-border: #1e3a5f;
            --color-speaker-b: #6ee7b7;
            --color-speaker-b-bg: #052e16;
            --color-speaker-b-border: #14532d;
            --color-unknown: #94a3b8;
            --color-unknown-bg: #1e293b;
            --color-unknown-border: #334155;
            --color-success: #4ade80;
            --color-danger: #f87171;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.4);
        }

        * { box-sizing: border-box; }

        body {
            background: var(--page-bg);
            color: var(--text-strong);
            transition: background-color 0.2s, color 0.2s;
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }

        /* ---- Segment Styles ---- */
        .segment {
            display: flex;
            gap: 0.75rem;
            padding: 0.875rem 1rem;
            margin-bottom: 0.375rem;
            border-radius: var(--radius);
            border: 1px solid transparent;
            transition: background-color 0.2s, border-color 0.2s;
        }
        .segment:hover { background: var(--surface-hover); }

        .segment--DOCTOR, .segment--SPEAKER_A {
            border-color: var(--color-speaker-a-border);
            background: var(--color-speaker-a-bg);
        }
        .segment--PATIENT, .segment--SPEAKER_B {
            border-color: var(--color-speaker-b-border);
            background: var(--color-speaker-b-bg);
        }
        .segment--UNKNOWN {
            border-color: var(--color-unknown-border);
            background: var(--color-unknown-bg);
        }

        .segment--relabeled {
            animation: segment-relabel 0.6s ease-out;
        }
        @keyframes segment-relabel {
            0% { opacity: 0.6; transform: translateX(-2px); }
            50% { opacity: 1; }
            100% { opacity: 1; transform: translateX(0); }
        }

        .segment__avatar {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.6875rem;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }
        .segment--DOCTOR .segment__avatar,
        .segment--SPEAKER_A .segment__avatar {
            background: var(--color-speaker-a-border);
            color: var(--color-speaker-a);
        }
        .segment--PATIENT .segment__avatar,
        .segment--SPEAKER_B .segment__avatar {
            background: var(--color-speaker-b-border);
            color: var(--color-speaker-b);
        }
        .segment--UNKNOWN .segment__avatar {
            background: var(--color-unknown-border);
            color: var(--color-unknown);
        }

        .segment__body { flex: 1; min-width: 0; }

        .segment__header {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            margin-bottom: 0.125rem;
        }

        .segment__speaker {
            font-weight: 600;
            font-size: 0.8125rem;
        }
        .segment--DOCTOR .segment__speaker,
        .segment--SPEAKER_A .segment__speaker { color: var(--color-speaker-a); }
        .segment--PATIENT .segment__speaker,
        .segment--SPEAKER_B .segment__speaker { color: var(--color-speaker-b); }
        .segment--UNKNOWN .segment__speaker { color: var(--color-unknown); }

        .segment__speaker[style*="cursor: pointer"]:hover {
            text-decoration: underline;
            text-decoration-style: dotted;
        }

        .segment__override-icon {
            display: inline-block;
            font-size: 0.625rem;
            margin-left: 0.25rem;
            vertical-align: super;
            opacity: 0.7;
        }

        .segment__time {
            font-size: 0.6875rem;
            color: var(--text-subtle);
            font-variant-numeric: tabular-nums;
        }

        .segment__texts {
            display: block;
            color: var(--text-strong);
            line-height: 1.6;
            font-size: 0.9375rem;
        }
        .segment__text {
            display: inline;
        }
        .segment__text + .segment__text::before {
            content: ' ';
        }

        /* ---- Summary Panel ---- */
        .summary-panel {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface-bg);
            margin-top: 0.75rem;
            overflow: hidden;
        }
        .summary-panel__toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            background: none;
            border: none;
            cursor: pointer;
            font: inherit;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-strong);
        }
        .summary-panel__toggle:hover { background: var(--surface-hover); }
        .summary-panel__chevron {
            transition: transform 0.2s;
            width: 16px; height: 16px;
        }
        .summary-panel--open .summary-panel__chevron { transform: rotate(180deg); }
        .summary-panel__body {
            padding: 0 1rem 1rem;
            display: none;
        }
        .summary-panel--open .summary-panel__body { display: block; }
        .summary-panel__loading {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem;
            color: var(--text-subtle);
            font-size: 0.875rem;
        }
        .summary-section { margin-bottom: 1rem; }
        .summary-section:last-child { margin-bottom: 0; }
        .summary-section__heading {
            font-weight: 600;
            font-size: 0.8125rem;
            color: var(--text-subtle);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.375rem;
        }
        .summary-section__content {
            font-size: 0.9375rem;
            line-height: 1.6;
            color: var(--text-strong);
        }
        .summary-key-points {
            list-style: disc;
            padding-left: 1.25rem;
            font-size: 0.875rem;
            line-height: 1.6;
            color: var(--text-strong);
        }

        /* ---- Replay Progress ---- */
        .replay-progress {
            height: 3px;
            background: var(--border);
            border-radius: 2px;
            overflow: hidden;
            margin-bottom: 0.5rem;
        }
        .replay-progress__fill {
            height: 100%;
            background: var(--color-speaker-a);
            transition: width 0.5s linear;
            border-radius: 2px;
        }

        /* ---- Recording Pulse ---- */
        .recording-pulse { animation: pulse 1.5s ease-in-out infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

        .recording-dot {
            width: 8px; height: 8px;
            background: #ef4444;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }

        /* ---- Panels ---- */
        .panel {
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            transition: background-color 0.2s, border-color 0.2s;
        }

        .confidence-badge { transition: all 0.5s ease; }
        .muted-text { color: var(--text-muted); }
        .subtle-text { color: var(--text-subtle); }
        .title-text { color: var(--text-strong); }

        /* ---- Buttons ---- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            font-size: 0.875rem;
            transition: all 0.15s;
            cursor: pointer;
            border: none;
        }
        .btn--primary { background: var(--accent); color: #fff; }
        .btn--primary:hover { opacity: 0.9; }
        .btn--danger { background: #ef4444; color: #fff; }
        .btn--danger:hover { background: #dc2626; }
        .btn--ghost {
            background: transparent;
            border: 1px solid var(--surface-border);
            color: var(--text-muted);
        }
        .btn--ghost:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }

        /* ---- Icon Button ---- */
        .icon-btn {
            width: 2.25rem;
            height: 2.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.5rem;
            border: 1px solid var(--surface-border);
            background: var(--surface-bg);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .icon-btn:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .icon-btn:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }
        .icon-btn svg { width: 18px; height: 18px; }

        /* ---- Mode Selector ---- */
        .mode-selector {
            position: relative;
            display: inline-flex;
        }
        .mode-selector__btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.625rem;
            border-radius: 0.375rem;
            border: 1px solid var(--surface-border);
            background: var(--surface-bg);
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
        }
        .mode-selector__btn:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .mode-selector__dropdown {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            min-width: 180px;
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            z-index: 40;
            padding: 0.25rem;
        }
        .mode-selector__option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.5rem 0.625rem;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 0.8125rem;
            cursor: pointer;
            border-radius: 0.375rem;
            transition: all 0.1s;
            text-align: left;
        }
        .mode-selector__option:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .mode-selector__option--active {
            background: var(--accent-soft);
            color: var(--accent);
            font-weight: 600;
        }
        .mode-selector__icon { font-size: 1rem; }

        /* ---- Scenario Panel (left) ---- */
        .scenario-panel {
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            border-right: 1px solid var(--surface-border);
            background: var(--surface-bg);
            display: flex;
            flex-direction: column;
            font-size: 0.8125rem;
        }
        .scenario-panel__header {
            padding: 1rem;
            border-bottom: 1px solid var(--surface-border);
            flex-shrink: 0;
        }
        .scenario-panel__title {
            font-weight: 700;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-subtle);
            margin-bottom: 0.75rem;
        }
        .scenario-panel__controls {
            display: flex;
            gap: 0.25rem;
            flex-wrap: wrap;
        }
        .scenario-panel__body {
            flex: 1;
            overflow-y: auto;
            padding: 0.5rem;
        }
        .scenario-item {
            padding: 0.625rem 0.75rem;
            border: 1px solid var(--surface-border);
            border-radius: 0.5rem;
            margin-bottom: 0.375rem;
            cursor: pointer;
            transition: all 0.15s;
        }
        .scenario-item:hover { background: var(--surface-hover); }
        .scenario-item--pass { border-left: 3px solid var(--color-success); }
        .scenario-item--fail { border-left: 3px solid var(--color-danger); }
        .scenario-item--running {
            border-left: 3px solid var(--accent);
            background: var(--surface-hover);
        }
        .scenario-item__name {
            font-weight: 600;
            font-size: 0.75rem;
            color: var(--text-strong);
        }
        .scenario-item__meta {
            font-size: 0.6875rem;
            color: var(--text-subtle);
            margin-top: 0.125rem;
        }
        .scenario-item__result {
            font-size: 0.6875rem;
            margin-top: 0.25rem;
        }
        .scenario-panel__progress {
            padding: 0 1rem 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .progress-bar {
            flex: 1;
            height: 4px;
            background: var(--surface-hover);
            border-radius: 2px;
            overflow: hidden;
        }
        .progress-bar__fill {
            height: 100%;
            background: var(--accent);
            border-radius: 2px;
            transition: width 0.3s;
        }
        .scenario-panel__footer {
            padding: 0.5rem;
            border-top: 1px solid var(--surface-border);
            flex-shrink: 0;
        }

        /* ---- Dev Panel (right) ---- */
        .dev-panel {
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            border-left: 1px solid var(--surface-border);
            background: var(--surface-bg);
            display: flex;
            flex-direction: column;
            font-size: 0.8125rem;
        }
        .dev-panel__header {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--surface-border);
            flex-shrink: 0;
        }
        .dev-panel__title {
            font-weight: 700;
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-subtle);
        }
        .dev-panel__tabs {
            display: flex;
            overflow-x: auto;
            border-bottom: 1px solid var(--surface-border);
            flex-shrink: 0;
            gap: 0;
        }
        .dev-panel__tab {
            padding: 0.5rem 0.75rem;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            color: var(--text-subtle);
            cursor: pointer;
            font-size: 0.6875rem;
            font-weight: 500;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            transition: color 0.15s, border-color 0.15s;
        }
        .dev-panel__tab:hover { color: var(--text-strong); }
        .dev-panel__tab--active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }
        .dev-panel__content {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem;
        }
        .dev-panel__log {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.6875rem;
            line-height: 1.5;
            max-height: calc(100vh - 140px);
            overflow-y: auto;
        }
        .dev-panel__entry {
            padding: 0.375rem 0.5rem;
            border-radius: 0.25rem;
            margin-bottom: 0.125rem;
            word-break: break-all;
            transition: background 0.1s;
        }
        .dev-panel__entry:hover { background: var(--surface-hover); }
        .dev-panel__pre {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.6875rem;
            background: var(--surface-bg-alt);
            padding: 0.75rem;
            border-radius: 0.5rem;
            border: 1px solid var(--surface-border);
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            color: var(--text-strong);
        }
        .dev-panel__btn {
            padding: 0.25rem 0.625rem;
            font-size: 0.6875rem;
            font-weight: 500;
            border: 1px solid var(--surface-border);
            border-radius: 0.375rem;
            background: var(--surface-bg);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }
        .dev-panel__btn:hover:not(:disabled) {
            background: var(--surface-hover);
            color: var(--text-strong);
        }
        .dev-panel__btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .dev-panel__btn--primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .dev-panel__btn--primary:hover:not(:disabled) { opacity: 0.85; color: #fff; background: var(--accent); }
        .dev-panel__btn--danger { color: var(--color-danger); border-color: var(--color-danger); }

        .sr-only {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
        }

        @media (max-width: 1279px) {
            .scenario-panel, .dev-panel {
                position: fixed;
                top: 0;
                height: 100vh;
                z-index: 50;
                box-shadow: var(--shadow-md);
            }
            .scenario-panel { left: 0; width: 85vw; max-width: 320px; }
            .dev-panel { right: 0; width: 85vw; max-width: 380px; }
            .panel-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.3);
                z-index: 49;
            }
        }
    </style>
</head>
<body class="min-h-screen">
    {% set dev = dev_panel_enabled is defined and dev_panel_enabled %}

    <div id="appLayout" class="{% if dev %}xl:grid xl:grid-cols-[280px,1fr,380px]{% else %}block{% endif %}" style="min-height:100vh;">

    {# ===== SCENARIO PANEL (LEFT) ===== #}
    {% if dev %}
    <aside id="scenarioPanel" class="scenario-panel">
        <div class="scenario-panel__header">
            <div class="scenario-panel__title">Demo Scenarios</div>
            <div class="scenario-panel__controls">
                <button onclick="scenarioRunner.runAll()" class="dev-panel__btn dev-panel__btn--primary" id="scenarioRunAllBtn">Run All</button>
                <button onclick="scenarioRunner.runRandom()" class="dev-panel__btn">Random</button>
                <button onclick="scenarioRunner.runFailed()" class="dev-panel__btn" id="scenarioRunFailedBtn" disabled title="No failed scenarios to re-run">Failed</button>
                <button onclick="scenarioRunner.stop()" class="dev-panel__btn dev-panel__btn--danger" id="scenarioStopBtn" disabled>Stop</button>
            </div>
        </div>
        <div id="scenarioProgress" class="scenario-panel__progress" style="display:none;">
            <div class="progress-bar">
                <div id="scenarioProgressFill" class="progress-bar__fill" style="width:0%"></div>
            </div>
            <span id="scenarioProgressText" class="text-xs subtle-text">0/0</span>
        </div>
        <div id="scenarioList" class="scenario-panel__body"></div>
        <div class="scenario-panel__footer">
            <button onclick="scenarioRunner.exportResults()" class="dev-panel__btn" id="scenarioExportBtn" style="display:none; width:100%;">Export Results</button>
        </div>
    </aside>
    {% endif %}

    {# ===== MAIN CONTENT ===== #}
    <main class="{% if dev %}px-6 py-6{% else %}max-w-4xl mx-auto px-4 py-8{% endif %}">

        {# Header #}
        <div class="mb-6 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                {% if dev %}
                <button onclick="toggleScenarioPanel()" class="icon-btn xl:hidden" aria-label="Toggle scenarios">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </button>
                {% endif %}
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="title-text text-xl font-bold tracking-tight" id="appTitle">Ambient Scribe</h1>
                        <div class="mode-selector" id="modeSelector">
                            <button class="mode-selector__btn" onclick="toggleModeDropdown()" id="modeSelectorBtn">
                                <span id="modeIcon"></span>
                                <span id="modeLabel"></span>
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4.5L6 7.5L9 4.5"/></svg>
                            </button>
                            <div class="mode-selector__dropdown" id="modeDropdown" style="display:none;"></div>
                        </div>
                    </div>
                    <p class="mt-0.5 text-xs muted-text" id="appSubtitle"></p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                {% if dev %}
                <button onclick="toggleDevPanelMobile()" class="icon-btn xl:hidden" aria-label="Toggle dev panel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </button>
                {% endif %}
                <button id="themeToggle" type="button" onclick="toggleTheme()" class="icon-btn" aria-pressed="false" aria-label="Toggle theme">
                    <svg id="themeIconLight" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    <svg id="themeIconDark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                </button>
            </div>
        </div>

        {# Controls #}
        <div class="panel p-3 mb-4 flex items-center gap-3 flex-wrap">
            <button id="startBtn" onclick="startRecording()" class="btn btn--primary" aria-label="Start recording (Space)" title="Start recording (Space)">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="5"/></svg>
                <span id="startBtnLabel">Start Recording</span>
                <span class="text-xs opacity-70">(Space)</span>
            </button>
            <button id="stopBtn" onclick="stopRecording()" class="btn btn--danger hidden" aria-label="Stop recording (Space or Escape)" title="Stop recording (Space / Esc)">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect x="2" y="2" width="10" height="10" rx="1.5"/></svg>
                Stop
                <span class="text-xs opacity-70">(Space)</span>
            </button>
            <button id="reconnectBtn" onclick="reconnect()" class="btn btn--ghost hidden" style="border-color:#f59e0b; color:#f59e0b;" aria-label="Reconnect">Reconnect</button>
            <button id="downloadBtn" onclick="downloadTranscript()" class="btn btn--ghost hidden" aria-label="Download transcript (D)" title="Download transcript (D)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                Download
                <span class="text-xs opacity-70">(D)</span>
            </button>
            <button id="resetBtn" onclick="resetSession()" class="btn btn--ghost hidden" aria-label="New session">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 105.64-11.36L1 10"/></svg>
                New Session
            </button>
            <span class="mx-1 text-xs muted-text">|</span>
            <button id="demoBtn" onclick="document.getElementById('demoFileInput').click()" class="btn btn--ghost" aria-label="Demo: replay a WAV file">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Demo
            </button>
            <input id="demoFileInput" type="file" accept=".wav,audio/wav" style="display:none" onchange="startReplay(this.files[0])">

            <div class="flex items-center gap-3 ml-auto">
                <span id="status" class="text-sm muted-text" aria-live="polite">Ready</span>
                <span id="audioLevel" class="hidden ml-2 text-xs" aria-live="polite"></span>
                <span id="confidenceBadge" class="confidence-badge text-xs px-2 py-0.5 rounded-full hidden" aria-label="Speaker identification confidence"></span>
                <span id="timer" class="text-sm font-mono subtle-text hidden" aria-label="Recording timer">00:00</span>
            </div>
        </div>

        {# System Banner #}
        <div id="systemBanner" class="hidden mb-4 px-4 py-3 rounded-lg bg-amber-100 text-amber-800 text-sm font-medium border border-amber-300"></div>
        <div id="toastContainer" style="position:fixed; bottom:1.5rem; right:1.5rem; z-index:50;"></div>

        {# Replay Progress #}
        <div id="replayProgress" class="replay-progress hidden">
            <div id="replayProgressFill" class="replay-progress__fill" style="width:0%"></div>
        </div>

        {# Transcript #}
        <div id="transcript" role="log" aria-live="polite" class="panel p-4 overflow-y-auto" style="min-height:400px; max-height:calc(100vh - 220px);">
            <p id="emptyState" class="text-center py-16">
                <svg class="mx-auto mb-3" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-subtle)" stroke-width="1.5" stroke-linecap="round"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                <span class="subtle-text block text-sm" id="emptyStateText">Click "Start Recording" to begin transcription.</span>
                <span class="subtle-text block text-xs mt-1">Ensure microphone access is allowed.</span>
            </p>
        </div>

        {# Summary Panel #}
        <div id="summaryPanel" class="summary-panel hidden">
            <button class="summary-panel__toggle" onclick="toggleSummary()" aria-expanded="false" aria-controls="summaryBody">
                <span id="summaryTitle">Session Summary</span>
                <svg class="summary-panel__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="summaryBody" class="summary-panel__body">
                <div id="summaryLoading" class="summary-panel__loading hidden">
                    <span class="recording-dot recording-pulse"></span>
                    Generating summary...
                </div>
                <div id="summaryContent"></div>
            </div>
        </div>

        {# Segment Count #}
        <div class="mt-1.5 text-xs muted-text text-right" role="status">
            <span id="segmentCount">0</span> segments
        </div>

        <div id="srAnnounce" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
    </main>

    {# ===== DEV PANEL (RIGHT) ===== #}
    {% if dev %}
    <aside id="devPanel" class="dev-panel">
        <div class="dev-panel__header">
            <span class="dev-panel__title">Dev Panel</span>
        </div>
        <div class="dev-panel__tabs">
            <button class="dev-panel__tab dev-panel__tab--active" data-tab="segments" onclick="devPanel.switchTab('segments')">Segments</button>
            <button class="dev-panel__tab" data-tab="pipeline" onclick="devPanel.switchTab('pipeline')">Pipeline</button>
            <button class="dev-panel__tab" data-tab="mercure" onclick="devPanel.switchTab('mercure')">Mercure</button>
            <button class="dev-panel__tab" data-tab="websocket" onclick="devPanel.switchTab('websocket')">WS</button>
            <button class="dev-panel__tab" data-tab="state" onclick="devPanel.switchTab('state')">State</button>
            <button class="dev-panel__tab" data-tab="raw" onclick="devPanel.switchTab('raw')">Raw</button>
        </div>

        <div class="dev-panel__content" data-content="segments">
            <div class="flex justify-end mb-1">
                <button onclick="devPanel.clearSegmentLog()" class="dev-panel__btn">Clear</button>
            </div>
            <div id="devSegmentLog" class="dev-panel__log"></div>
        </div>

        <div class="dev-panel__content" data-content="pipeline" style="display:none;">
            <button onclick="devPanel.fetchHealth()" class="dev-panel__btn mb-2">Refresh Health</button>
            <pre id="devPipelineInfo" class="dev-panel__pre">Click Refresh to fetch /health</pre>
        </div>

        <div class="dev-panel__content" data-content="mercure" style="display:none;">
            <div id="devMercureLog" class="dev-panel__log">
                <div class="dev-panel__entry subtle-text">Waiting for Mercure events...</div>
            </div>
        </div>

        <div class="dev-panel__content" data-content="websocket" style="display:none;">
            <div id="devWsStatus" class="dev-panel__pre mb-2">No WebSocket connection</div>
            <div id="devWsLog" class="dev-panel__log"></div>
        </div>

        <div class="dev-panel__content" data-content="state" style="display:none;">
            <pre id="devStateSnapshot" class="dev-panel__pre">Loading...</pre>
        </div>

        <div class="dev-panel__content" data-content="raw" style="display:none;">
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs subtle-text"><span id="devRawCount">0</span>/200</span>
                <button onclick="devPanel.copyAllRaw()" class="dev-panel__btn">Copy All</button>
            </div>
            <div id="devRawLog" class="dev-panel__log"></div>
        </div>
    </aside>
    {% endif %}

    </div>{# /appLayout #}

    <script>
    const CONFIG = {
        sessionId: '{{ session_id }}',
        wsUrl: '{{ ws_url }}',
        mercureUrl: '{{ mercure_url }}',
        topicRaw: '{{ mercure_topic_raw }}',
        topicRoles: '{{ mercure_topic_roles }}',
        topicSummary: 'scribe/session/{{ session_id }}/summary',
        enableRoleUpdates: {{ enable_role_updates ? 'true' : 'false' }},
    };
    {% if dev_panel_enabled is defined and dev_panel_enabled %}
    const SCENARIOS = {{ scenarios|json_encode|raw }};
    {% endif %}
    </script>
    <script src="/js/scribe.js"></script>
    {% if dev_panel_enabled is defined and dev_panel_enabled %}
    <script src="/js/scribe-dev.js"></script>
    {% endif %}
</body>
</html>
