<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ambient Scribe — Medical Transcription</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        (function () {
            const storageKey = 'ambient-scribe-theme';
            const storedTheme = localStorage.getItem(storageKey);
            const preferredTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
            document.documentElement.dataset.theme = storedTheme || preferredTheme;
        })();
    </script>
    <style>
        :root {
            color-scheme: light;
            --page-bg: #eef2f7;
            --surface-bg: #ffffff;
            --surface-border: #d6dee8;
            --surface-hover: #f8fafc;
            --text-strong: #0f172a;
            --text-muted: #475569;
            --text-subtle: #64748b;
            --color-doctor: #1d4ed8;
            --color-doctor-bg: #dbeafe;
            --color-patient: #166534;
            --color-patient-bg: #dcfce7;
            --color-unknown: #334155;
            --color-unknown-bg: #e2e8f0;
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --page-bg: #020617;
            --surface-bg: #0f172a;
            --surface-border: #334155;
            --surface-hover: #162033;
            --text-strong: #e2e8f0;
            --text-muted: #cbd5e1;
            --text-subtle: #94a3b8;
            --color-doctor: #93c5fd;
            --color-doctor-bg: #172554;
            --color-patient: #86efac;
            --color-patient-bg: #14532d;
            --color-unknown: #cbd5e1;
            --color-unknown-bg: #1e293b;
        }

        body {
            background: var(--page-bg);
            color: var(--text-strong);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .segment {
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0.5rem;
            border: 1px solid rgba(15, 23, 42, 0.08);
            color: var(--text-strong);
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        .segment--DOCTOR {
            border-left: 3px solid var(--color-doctor);
            background: var(--color-doctor-bg);
        }

        .segment--PATIENT {
            border-left: 3px solid var(--color-patient);
            background: var(--color-patient-bg);
        }

        .segment--UNKNOWN {
            border-left: 3px solid var(--color-unknown);
            background: var(--color-unknown-bg);
            opacity: 0.8;
        }

        .segment__speaker {
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .segment__time {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-left: 0.5rem;
        }

        .segment__text {
            display: block;
            margin-top: 0.25rem;
            color: var(--text-strong);
            line-height: 1.55;
        }

        .recording-pulse {
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .confidence-badge {
            transition: all 0.5s ease;
        }

        .panel {
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .muted-text {
            color: var(--text-muted);
        }

        .subtle-text {
            color: var(--text-subtle);
        }

        .title-text {
            color: var(--text-strong);
        }

        .theme-toggle {
            background: var(--surface-bg);
            border: 1px solid var(--surface-border);
            color: var(--text-muted);
        }

        .theme-toggle:hover {
            background: var(--surface-hover);
            color: var(--text-strong);
        }

        .theme-toggle:focus-visible {
            outline: 2px solid var(--color-doctor);
            outline-offset: 2px;
        }
    </style>
</head>
<body class="min-h-screen">
    <div class="max-w-4xl mx-auto px-4 py-8">

        <!-- Header -->
        <div class="mb-8 flex items-start justify-between gap-4">
            <div>
                <h1 class="title-text text-2xl font-bold">
                    Ambient Medical Scribe
                </h1>
                <p class="mt-1 text-sm muted-text">
                    Real-time consultation transcription with speaker identification
                </p>
            </div>
            <button
                id="themeToggle"
                type="button"
                onclick="toggleTheme()"
                class="theme-toggle rounded-full px-3 py-2 text-sm font-medium transition-colors"
                aria-pressed="false"
            ></button>
        </div>

        <!-- Controls -->
        <div class="panel rounded-lg shadow-sm p-4 mb-6 flex items-center gap-4">
            <button
                id="startBtn"
                onclick="startRecording()"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
            >
                Start Consultation
            </button>
            <button
                id="stopBtn"
                onclick="stopRecording()"
                class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium hidden"
            >
                End Consultation
            </button>

            <!-- Status -->
            <span id="status" class="text-sm muted-text">
                Ready
            </span>

            <!-- Confidence Badge -->
            <span id="confidenceBadge" class="confidence-badge ml-auto text-xs px-2 py-1 rounded-full hidden">
            </span>

            <!-- Timer -->
            <span id="timer" class="text-sm font-mono subtle-text hidden">
                00:00
            </span>
        </div>

        <!-- Transcript -->
        <div
            id="transcript"
            class="panel rounded-lg shadow-sm p-4 min-h-[400px] max-h-[600px] overflow-y-auto"
        >
            <p id="emptyState" class="text-center subtle-text py-12">
                Click "Start Consultation" to begin recording.
                <br>
                <span class="text-xs">Ensure microphone access is allowed.</span>
            </p>
        </div>

        <!-- Segment Count -->
        <div class="mt-2 text-xs muted-text text-right">
            <span id="segmentCount">0</span> segments
        </div>
    </div>

    <script>
    // =========================================================================
    // Configuration (injected by Symfony/Twig)
    // =========================================================================
    const CONFIG = {
        sessionId: '{{ session_id }}',
        wsUrl: '{{ ws_url }}',
        mercureUrl: '{{ mercure_url }}',
        topicRaw: '{{ mercure_topic_raw }}',
        topicRoles: '{{ mercure_topic_roles }}',
        enableRoleUpdates: {{ enable_role_updates ? 'true' : 'false' }},
    };
    const THEME_STORAGE_KEY = 'ambient-scribe-theme';

    function getCurrentTheme() {
        return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    }

    function applyTheme(theme) {
        const resolvedTheme = theme === 'dark' ? 'dark' : 'light';
        const toggle = document.getElementById('themeToggle');

        document.documentElement.dataset.theme = resolvedTheme;

        if (toggle) {
            toggle.textContent = resolvedTheme === 'dark' ? 'Theme: Dark' : 'Theme: Light';
            toggle.setAttribute('aria-pressed', resolvedTheme === 'dark' ? 'true' : 'false');
        }
    }

    function toggleTheme() {
        const nextTheme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
        localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
        applyTheme(nextTheme);
    }

    applyTheme(localStorage.getItem(THEME_STORAGE_KEY) || getCurrentTheme());

    // =========================================================================
    // StreamOrchestrator — manages EventSource connections to Mercure
    // =========================================================================
    // Based on halaxy-agents-lab stream orchestrator pattern.
    //
    // Features:
    //   - Auto-reconnection with exponential backoff (1s → 2s → 4s, max 30s)
    //   - Multi-topic management (raw segments + role updates)
    //   - Connection state tracking with callbacks
    //   - Graceful teardown on page unload
    //   - Reconnection counter for observability

    class StreamOrchestrator {
        constructor(mercureUrl) {
            this._mercureUrl = mercureUrl;
            this._streams = new Map();   // topic → { source, handler, retries, backoffMs, timer }
            this._active = false;

            // Tear down all connections when the page unloads
            window.addEventListener('beforeunload', () => this.disconnectAll());
        }

        /**
         * Subscribe to a Mercure topic with auto-reconnection.
         * @param {string} topic    - The Mercure topic URI
         * @param {function} handler - Called with parsed JSON for each message
         */
        subscribe(topic, handler) {
            if (this._streams.has(topic)) {
                console.warn(`StreamOrchestrator: already subscribed to ${topic}`);
                return;
            }

            const state = { source: null, handler, retries: 0, backoffMs: 1000, timer: null };
            this._streams.set(topic, state);
            this._active = true;
            this._connect(topic, state);
        }

        /** Disconnect a single topic. */
        unsubscribe(topic) {
            const state = this._streams.get(topic);
            if (!state) return;

            clearTimeout(state.timer);
            state.source?.close();
            this._streams.delete(topic);
        }

        /** Disconnect all topics and stop reconnection. */
        disconnectAll() {
            this._active = false;
            for (const [topic, state] of this._streams) {
                clearTimeout(state.timer);
                state.source?.close();
            }
            this._streams.clear();
        }

        /** @returns {boolean} True if any stream is connected. */
        get isConnected() {
            for (const state of this._streams.values()) {
                if (state.source?.readyState === EventSource.OPEN) return true;
            }
            return false;
        }

        /** @returns {number} Total reconnection attempts across all topics. */
        get totalRetries() {
            let total = 0;
            for (const state of this._streams.values()) total += state.retries;
            return total;
        }

        _connect(topic, state) {
            if (!this._active || !this._mercureUrl) return;

            const url = new URL(this._mercureUrl);
            url.searchParams.append('topic', topic);

            const source = new EventSource(url);
            state.source = source;

            source.onmessage = (event) => {
                // Reset backoff on successful message
                state.backoffMs = 1000;
                state.retries = 0;

                try {
                    state.handler(JSON.parse(event.data));
                } catch (err) {
                    console.error(`StreamOrchestrator: parse error on ${topic}`, err);
                }
            };

            source.onerror = () => {
                source.close();
                if (!this._active) return;

                state.retries++;
                console.warn(
                    `StreamOrchestrator: ${topic} disconnected, ` +
                    `retry #${state.retries} in ${state.backoffMs}ms`
                );

                state.timer = setTimeout(() => {
                    this._connect(topic, state);
                }, state.backoffMs);

                // Exponential backoff: 1s → 2s → 4s → ... → 30s max
                state.backoffMs = Math.min(state.backoffMs * 2, 30000);
            };

            source.onopen = () => {
                console.log(`StreamOrchestrator: connected to ${topic}`);
            };
        }
    }

    // =========================================================================
    // PCM Streamer - captures mic audio as 16kHz mono PCM
    // =========================================================================
    class PcmStreamer {
        constructor(stream, options = {}) {
            this._stream = stream;
            this._targetSampleRate = options.targetSampleRate || 16000;
            this._chunkMs = options.chunkMs || 5000;
            this._onChunk = options.onChunk || (() => {});
            this._audioContext = null;
            this._source = null;
            this._processor = null;
            this._silence = null;
            this._buffers = [];
            this._bufferedBytes = 0;
            this._bytesPerChunk = this._targetSampleRate * 2 * (this._chunkMs / 1000);
        }

        async start() {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (!AudioContextClass) {
                throw new Error('Web Audio API is not supported in this browser');
            }

            this._audioContext = new AudioContextClass();
            await this._audioContext.resume();

            this._source = this._audioContext.createMediaStreamSource(this._stream);
            this._processor = this._audioContext.createScriptProcessor(4096, 1, 1);
            this._silence = this._audioContext.createGain();
            this._silence.gain.value = 0;

            this._processor.onaudioprocess = (event) => {
                const input = event.inputBuffer.getChannelData(0);
                const downsampled = this._downsampleBuffer(
                    input,
                    this._audioContext.sampleRate,
                    this._targetSampleRate
                );
                const pcmChunk = this._floatTo16BitPcm(downsampled);

                if (pcmChunk.byteLength === 0) {
                    return;
                }

                this._buffers.push(pcmChunk);
                this._bufferedBytes += pcmChunk.byteLength;

                if (this._bufferedBytes >= this._bytesPerChunk) {
                    this.flush();
                }
            };

            this._source.connect(this._processor);
            this._processor.connect(this._silence);
            this._silence.connect(this._audioContext.destination);
        }

        flush() {
            if (this._bufferedBytes === 0) {
                return;
            }

            const merged = new Uint8Array(this._bufferedBytes);
            let offset = 0;
            for (const chunk of this._buffers) {
                merged.set(chunk, offset);
                offset += chunk.byteLength;
            }

            this._buffers = [];
            this._bufferedBytes = 0;
            this._onChunk(merged.buffer);
        }

        stop() {
            this.flush();
            this._processor?.disconnect();
            this._source?.disconnect();
            this._silence?.disconnect();
            this._processor = null;
            this._source = null;
            this._silence = null;

            if (this._audioContext) {
                this._audioContext.close().catch(() => {});
                this._audioContext = null;
            }
        }

        _downsampleBuffer(buffer, inputSampleRate, outputSampleRate) {
            if (inputSampleRate === outputSampleRate) {
                return new Float32Array(buffer);
            }

            if (inputSampleRate < outputSampleRate) {
                throw new Error(
                    `Cannot upsample audio from ${inputSampleRate}Hz to ${outputSampleRate}Hz`
                );
            }

            const sampleRateRatio = inputSampleRate / outputSampleRate;
            const outputLength = Math.round(buffer.length / sampleRateRatio);
            const outputBuffer = new Float32Array(outputLength);

            let outputOffset = 0;
            let inputOffset = 0;

            while (outputOffset < outputLength) {
                const nextInputOffset = Math.round((outputOffset + 1) * sampleRateRatio);
                let accumulator = 0;
                let count = 0;

                for (let i = inputOffset; i < nextInputOffset && i < buffer.length; i++) {
                    accumulator += buffer[i];
                    count++;
                }

                outputBuffer[outputOffset] = count > 0 ? accumulator / count : 0;
                outputOffset++;
                inputOffset = nextInputOffset;
            }

            return outputBuffer;
        }

        _floatTo16BitPcm(floatBuffer) {
            const pcmBuffer = new Int16Array(floatBuffer.length);
            for (let i = 0; i < floatBuffer.length; i++) {
                const sample = Math.max(-1, Math.min(1, floatBuffer[i]));
                pcmBuffer[i] = sample < 0 ? sample * 0x8000 : sample * 0x7fff;
            }

            return new Uint8Array(pcmBuffer.buffer);
        }
    }

    // =========================================================================
    // State
    // =========================================================================
    let ws = null;
    let pcmStreamer = null;
    let mediaStream = null;
    let timerInterval = null;
    let startTime = null;
    let segmentIndex = 0;
    let roleMapping = {};    // e.g., { "spk_0": "DOCTOR", "spk_1": "PATIENT" }
    let confidence = 0;
    let streams = null;      // StreamOrchestrator instance

    // =========================================================================
    // Recording Controls
    // =========================================================================

    async function startRecording() {
        try {
            // Request microphone access
            mediaStream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    channelCount: 1,
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true,
                }
            });

            // Connect WebSocket to Python agent
            ws = new WebSocket(`${CONFIG.wsUrl}/ws/transcribe/${CONFIG.sessionId}`);
            ws.binaryType = 'arraybuffer';

            ws.onopen = async () => {
                console.log('WebSocket connected');

                try {
                    pcmStreamer = new PcmStreamer(mediaStream, {
                        targetSampleRate: 16000,
                        chunkMs: 5000,
                        onChunk: (pcmChunk) => {
                            if (ws?.readyState === WebSocket.OPEN) {
                                ws.send(pcmChunk);
                            }
                        }
                    });

                    await pcmStreamer.start();
                } catch (err) {
                    console.error('PCM stream setup failed:', err);
                    document.getElementById('status').textContent = `Audio setup error: ${err.message}`;
                    pcmStreamer?.stop();
                    pcmStreamer = null;
                    ws?.close();
                }
            };

            ws.onclose = () => {
                console.log('WebSocket closed');
                pcmStreamer?.stop();
                pcmStreamer = null;
            };
            ws.onerror = (e) => {
                console.error('WebSocket error:', e);
                document.getElementById('status').textContent = 'Streaming error';
            };

            // Subscribe to Mercure for transcript segments
            subscribeToMercure();

            // Update UI
            document.getElementById('startBtn').classList.add('hidden');
            document.getElementById('stopBtn').classList.remove('hidden');
            document.getElementById('status').innerHTML =
                '<span class="recording-pulse text-red-500 font-medium">Recording</span>';
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('timer').classList.remove('hidden');

            // Start timer
            startTime = Date.now();
            timerInterval = setInterval(updateTimer, 1000);

        } catch (err) {
            console.error('Failed to start recording:', err);
            document.getElementById('status').textContent =
                err.name === 'NotAllowedError'
                    ? 'Microphone access denied'
                    : `Error: ${err.message}`;
        }
    }

    function stopRecording() {
        pcmStreamer?.stop();
        pcmStreamer = null;
        ws?.close();
        mediaStream?.getTracks().forEach(t => t.stop());
        streams?.disconnectAll();

        clearInterval(timerInterval);

        document.getElementById('startBtn').classList.remove('hidden');
        document.getElementById('stopBtn').classList.add('hidden');
        document.getElementById('status').textContent = 'Consultation ended';
    }

    // =========================================================================
    // Mercure SSE Subscription (via StreamOrchestrator)
    // =========================================================================

    function subscribeToMercure() {
        if (!CONFIG.mercureUrl) {
            console.warn('Mercure URL not configured — segments will not appear in real-time');
            return;
        }

        streams = new StreamOrchestrator(CONFIG.mercureUrl);
        streams.subscribe(CONFIG.topicRaw, handleRawSegment);
        if (CONFIG.enableRoleUpdates) {
            streams.subscribe(CONFIG.topicRoles, handleRoleUpdate);
        }
    }

    // =========================================================================
    // Segment Rendering
    // =========================================================================

    function handleRawSegment(data) {
        if (data.type === 'finalized') {
            document.getElementById('status').textContent = 'Transcript finalized';
            return;
        }
        if (data.type === 'error') {
            console.error('Transcription error:', data.message);
            document.getElementById('status').textContent = `Transcription error: ${data.message}`;
            return;
        }
        if (data.type !== 'segment') return;

        const role = roleMapping[data.speaker_id] || 'UNKNOWN';
        appendSegment(data, role);
    }

    function appendSegment(segment, role) {
        const container = document.getElementById('transcript');
        const el = document.createElement('div');
        const id = `segment-${segmentIndex++}`;

        el.id = id;
        el.className = `segment segment--${role}`;
        el.dataset.speakerId = segment.speaker_id;
        el.dataset.start = segment.start;
        el.dataset.end = segment.end;

        const speakerLabel = role === 'UNKNOWN' ? segment.speaker_id : role;
        const timeStr = formatTime(segment.start);

        el.innerHTML = `
            <span class="segment__speaker" style="color: ${getRoleColor(role)}">${speakerLabel}</span>
            <span class="segment__time">${timeStr}</span>
            <span class="segment__text">${escapeHtml(segment.text)}</span>
        `;

        container.appendChild(el);

        // Auto-scroll if near bottom
        if (container.scrollHeight - container.scrollTop - container.clientHeight < 100) {
            container.scrollTop = container.scrollHeight;
        }

        // Update count
        document.getElementById('segmentCount').textContent = segmentIndex;
    }

    // =========================================================================
    // Role Updates (from Strands agent)
    // =========================================================================

    function handleRoleUpdate(data) {
        if (!data.mapping) return;

        roleMapping = data.mapping;
        confidence = data.confidence || 0;

        // Update confidence badge
        const badge = document.getElementById('confidenceBadge');
        badge.classList.remove('hidden');
        if (confidence >= 0.8) {
            badge.textContent = `Roles identified (${Math.round(confidence * 100)}%)`;
            badge.className = 'confidence-badge ml-auto text-xs px-2 py-1 rounded-full bg-green-100 text-green-800';
        } else {
            badge.textContent = 'Identifying speakers...';
            badge.className = 'confidence-badge ml-auto text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600 recording-pulse';
        }

        // Retroactively relabel existing segments
        relabelSegments();
    }

    function relabelSegments() {
        document.querySelectorAll('.segment').forEach(el => {
            const speakerId = el.dataset.speakerId;
            const newRole = roleMapping[speakerId] || 'UNKNOWN';

            // Update CSS class
            el.className = `segment segment--${newRole}`;

            // Update label
            const label = el.querySelector('.segment__speaker');
            if (label) {
                label.textContent = newRole === 'UNKNOWN' ? speakerId : newRole;
                label.style.color = getRoleColor(newRole);
            }
        });
    }

    // =========================================================================
    // Utilities
    // =========================================================================

    function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function updateTimer() {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        document.getElementById('timer').textContent = formatTime(elapsed);
    }

    function getRoleColor(role) {
        switch (role) {
            case 'DOCTOR': return 'var(--color-doctor)';
            case 'PATIENT': return 'var(--color-patient)';
            default: return 'var(--color-unknown)';
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    </script>
</body>
</html>
